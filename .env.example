# Copy to `.env` (gitignored) and fill in your own endpoints.
#   cp .env.example .env
#
# Read by scripts/vllm_host_proxy.py, which supplies the `Host` header that a
# vhost-dispatching vLLM router requires and OpenEvolve cannot set itself.

# The host you can actually reach: Tailscale node, SSH tunnel, or LAN address.
VLLM_UPSTREAM_HOST=vllm.internal.example
VLLM_UPSTREAM_PORT=80

# The vhost the router matches on, sent as the `Host` header.
# Defaults to VLLM_UPSTREAM_HOST when the two are the same.
VLLM_ROUTER_HOST=vllm.internal.example

# Where the proxy listens; must match `api_base` in evolution/config.brain-tailscale.yaml.
VLLM_PROXY_PORT=8082

# Per-request timeout in seconds. A large reasoning model needs generous headroom.
VLLM_TIMEOUT=900

# Hosted Cerebras backend: uv run kaprekarevolve evolve -b cerebras
CEREBRAS_API_KEY=
